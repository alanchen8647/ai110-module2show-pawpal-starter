classDiagram
    %% PawPal+ class diagram: owner, pet, task, and daily plan.
    %% IDs are auto-generated. Pet/owner links are kept in sync on both sides.
    %% Owner is reached from a Task through its Pet (Task.petId -> Pet.owner).
    %% Times are stored as hour/minute parts; duration is hour/minute parts too.

    class PetOwner {
        +int clientId
        +string name
        +string email
        +string phone
        +List~Pet~ pets
        +addClient(client) void
        +setName(name) void
        +setEmail(email) void
        +setPhone(phone) void
        +removeClient(clientId) void
        +addPet(pet) void
        +removePet(petId) void
    }

    class Pet {
        +int petId
        +string petName
        +string petSpecies
        +string breed
        +int age
        +int ownerId
        +PetOwner owner
        +string gender
        +string animalCategory
        +List~Task~ tasks
        +createPet() Pet
        +setName(name) void
        +setSpecies(species) void
        +setBreed(breed) void
        +setAge(age) void
        +setOwnerId(ownerId) void
        +setGender(gender) void
        +setAnimalCategory(category) void
        +removePet() void
        +addTask(task) void
    }

    class Task {
        +int taskId
        +int petId
        +string status
        +string type
        +int timeStartHour
        +int timeStartMinutes
        +int timeEndHour
        +int timeEndMinutes
        +int timeDurationHour
        +int timeDurationMinutes
        +int priority
        +string ownerPreferences
        +createTasks() Task
        +setPet(petId) void
        +markTaskComplete() void
        +markIncomplete() void
        +markPending() void
        +setType(type) void
        +setTimeStart(hour, minutes) void
        +setTimeEnd(hour, minutes) void
        +setDuration(hour, minutes) void
        +setPriority(priority) void
        +setOwnerPreferences(preferences) void
    }

    class PlanSchedule {
        +int planId
        +date date
        +List~Task~ arrayOfTasks
        +string status
        +setPlan() void
        +checkForTimeAvailability(startHour, startMinutes, durationHour, durationMinutes) bool
        +addTasks(task) void
        +removeTasks(taskId) void
        +markPlanComplete() void
        +checkForCompletion() bool
        +removePlan() void
    }

    PetOwner "1" *-- "0..*" Pet : pets
    Pet "0..*" --> "0..1" PetOwner : owner
    Pet "1" *-- "0..*" Task : tasks (petId)
    PlanSchedule "1" o-- "0..*" Task : arrayOfTasks
